+    /**
+     * Bare: opens the homepage in a new tab. A bookmarks homepage opens on the Bookmarks bar
+     * folder rather than on the list of top-level folders.
+     */
+    private void launchHomepageTab(boolean incognito, String url, @TabLaunchType int type) {
+        boolean bookmarksRoot =
+                (url.startsWith("chrome://bookmarks") || url.startsWith("chrome-native://bookmarks"))
+                        && !url.contains("/folder/");
+        Profile profile =
+                bookmarksRoot ? getTabModelSelector().getModel(incognito).getProfile() : null;
+        BookmarkModel model =
+                profile == null ? null : BookmarkModel.getForProfile(profile.getOriginalProfile());
+        if (model == null) {
+            getTabCreator(incognito).launchUrl(url, type);
+            return;
+        }
+        BookmarkId loadedFolder =
+                model.isBookmarkModelLoaded() ? model.getDesktopFolderId() : null;
+        if (loadedFolder != null) {
+            String folderUrl = BookmarkUiState.createFolderUrl(loadedFolder).toString();
+            rememberBookmarksBarUrl(folderUrl);
+            getTabCreator(incognito).launchUrl(folderUrl, type);
+            return;
         }
+        // The bookmarks are not loaded yet. Open the Bookmarks bar folder remembered from an
+        // earlier start: the bookmarks page then shows it as soon as it loads, with no list of
+        // top-level folders first. Moving an already open list to the folder afterwards lost a
+        // race with the page applying its own first URL now and then.
+        String remembered =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.BARE_BOOKMARKS_BAR_URL, null);
+        boolean haveRemembered =
+                remembered != null && remembered.startsWith("chrome-native://bookmarks/folder/");
+        Tab tab = getTabCreator(incognito).launchUrl(haveRemembered ? remembered : url, type);
+        if (tab == null) return;
+        model.finishLoadingBookmarkModel(
+                () ->
+                        PostTask.postTask(
+                                TaskTraits.UI_DEFAULT,
+                                () -> {
+                                    BookmarkId folder = model.getDesktopFolderId();
+                                    if (tab.isDestroyed() || folder == null) return;
+                                    String folderUrl =
+                                            BookmarkUiState.createFolderUrl(folder).toString();
+                                    rememberBookmarksBarUrl(folderUrl);
+                                    // First start, or the folder changed: move the tab there.
+                                    if (folderUrl.equals(remembered)) return;
+                                    LoadUrlParams params = new LoadUrlParams(folderUrl);
+                                    params.setShouldReplaceCurrentEntry(true);
+                                    tab.loadUrl(params);
+                                }));
+    }
+
+    private static void rememberBookmarksBarUrl(String folderUrl) {
+        ChromeSharedPreferences.getInstance()
+                .writeString(ChromePreferenceKeys.BARE_BOOKMARKS_BAR_URL, folderUrl);
     }
 
