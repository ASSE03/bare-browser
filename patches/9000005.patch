+    /** Bare: longest time the bookmarks page stays up over a site that has not painted yet. */
+    private static final long BARE_BOOKMARKS_HOLD_MAX_MS = 2000;
+
+    /** Bare: set while the bookmarks page stays up over a committed site that has not painted. */
+    private boolean mBareHoldingBookmarksPage;
+
+    /** Bare: tells a pending timeout apart from a later hold. */
+    private int mBareHoldGeneration;
+
+    /**
+     * Bare: a site opened from the bookmarks page shows, until it paints, whatever the tab held
+     * under the bookmarks page: the site before it, or another bookmarks screen. The bookmarks page
+     * stays up instead until the site's first paint, a failure, or two seconds.
+     */
+    private boolean maybeHoldBookmarksPage(GURL url) {
+        NativePage page = mNativePage;
+        boolean placeholder = mBareBookmarksPlaceholder;
+        mBareBookmarksPlaceholder = false;
+        if (page == null || page.isFrozen() || (mIsHidden && !placeholder)) return false;
+        if (!"bookmarks".equals(Uri.parse(page.getUrl()).getHost())) return false;
+        String scheme = url.getScheme();
+        if (!"https".equals(scheme) && !"http".equals(scheme)) return false;
+        mBareHoldingBookmarksPage = true;
+        int generation = ++mBareHoldGeneration;
+        PostTask.postDelayedTask(
+                TaskTraits.UI_DEFAULT,
+                () -> {
+                    if (generation == mBareHoldGeneration) releaseHeldBookmarksPage();
+                },
+                BARE_BOOKMARKS_HOLD_MAX_MS);
+        return true;
+    }
+
+    /** Bare: set while a bookmarks page stands in for the site the tab showed before. */
+    private boolean mBareBookmarksPlaceholder;
+
+    /** Bare: tells a pending placeholder timeout apart from a later placeholder. */
+    private int mBarePlaceholderGeneration;
+
+    /**
+     * Bare: on phones the bookmarks list is its own screen above the browser. When a bookmark is
+     * opened from it, the browser comes back showing the tab's previous site until the bookmark
+     * commits and paints. The bookmarks page is shown in the tab in the meantime; {@link
+     * #maybeHoldBookmarksPage} keeps it up until the site's first paint.
+     */
+    @Override
+    public void bareShowBookmarksUntilPaint(String bookmarksUrl) {
+        if (isDestroyed() || mNativeTabAndroid == 0) return;
+        if (!maybeShowNativePage(bookmarksUrl, /* forceReload= */ false, /* pdfInfo= */ null)) {
+            return;
+        }
+        mBareBookmarksPlaceholder = true;
+        int generation = ++mBarePlaceholderGeneration;
+        PostTask.postDelayedTask(
+                TaskTraits.UI_DEFAULT,
+                () -> {
+                    // The site never committed (blocked, handed to another app...): show the tab.
+                    if (generation == mBarePlaceholderGeneration && mBareBookmarksPlaceholder) {
+                        releaseHeldBookmarksPage();
+                    }
