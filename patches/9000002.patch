+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.os.IBinder;
+
+import org.chromium.base.Log;
+import org.chromium.base.SplitCompatService;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+
+/**
+ * A plain started service whose only job is {@link #onTaskRemoved}, which Android calls when the
+ * user swipes Bare away from the recent apps screen.
+ *
+ * <p>It is started while Bare is in the foreground, when starting a service is always allowed, and
+ * holds no notification. Android stops it on its own a little while after Bare goes to the
+ * background, and may end the process right after a swipe before the clear is done. Neither loses
+ * anything: the armed flag stays set until the clear has finished, and the next start finishes it
+ * before any page is shown.
+ */
+@NullMarked
+public class BareSwipeWatchServiceImpl extends SplitCompatService.Impl {
+    private static final String TAG = "BareSwipeWatch";
+
+    /** Starts watching if the option is on. Call from the foreground only. */
+    public static void watch(Context context) {
+        if (!BareClearOnExit.isClearOnSwipe()) return;
+        try {
+            context.startService(new Intent(context, BareSwipeWatchService.class));
+        } catch (IllegalStateException | SecurityException e) {
+            // Not allowed right now. The next start still catches the swipe.
+            Log.w(TAG, "Could not start the swipe watch", e);
+        }
+    }
+
+    @Override
+    public int onStartCommand(@Nullable Intent intent, int flags, int startId) {
+        if (!BareClearOnExit.isClearOnSwipe()) {
+            getService().stopSelf();
+        }
+        // Nothing to pick up again if Android ends it.
+        return Service.START_NOT_STICKY;
+    }
+
+    @Override
+    public void onTaskRemoved(Intent rootIntent) {
+        if (!BareClearOnExit.isSwipeArmed() || !ProfileManager.isInitialized()) {
+            getService().stopSelf();
+            return;
+        }
+        Profile profile = ProfileManager.getLastUsedRegularProfile().getOriginalProfile();
+        boolean closeTabs = BareClearOnExit.isCloseTabs();
+        BareClearOnExit.clearThen(
+                profile,
+                () -> {
+                    // Tabs are closed by the next start, which still finds the flag set. With
+                    // nothing more to do, the next start has no reason to cover anything.
+                    if (!closeTabs) BareClearOnExit.disarmSwipe();
+                    getService().stopSelf();
+                });
+    }
+
+    @Override
+    public @Nullable IBinder onBind(Intent intent) {
+        return null;
+    }
+}
