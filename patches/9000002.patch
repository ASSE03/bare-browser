+    /**
+     * On the first start of a browser window: whether Bare was swiped away while armed. A window
+     * that comes back after Bare was only in the background is the same one, or is rebuilt from its
+     * saved state; a window built from nothing means the old one was removed from recent apps. That
+     * holds whether Android has already ended the old process or reuses it, as it does when Bare is
+     * reopened right after the swipe. If so, the swipe clear is marked pending for the start to
+     * carry out. The armed flag is cleared either way.
+     */
+    public static boolean consumeSwipedAway(boolean freshWindow) {
+        boolean armed = isSwipeArmed();
+        disarmSwipe();
+        if (!armed || !isClearOnSwipe() || !freshWindow) return false;
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.BARE_CLEAR_SWIPE_PENDING, true);
+        return true;
+    }
+
+    /** Reads and clears the mark {@link #consumeSwipedAway} left. */
+    public static boolean takeSwipeClearPending() {
+        boolean pending =
+                ChromeSharedPreferences.getInstance()
+                        .readBoolean(ChromePreferenceKeys.BARE_CLEAR_SWIPE_PENDING, false);
