+     */
+    public static void replaceAllTabs(TabModelSelector selector, Runnable openNewTab) {
+        List<List<Tab>> before = new ArrayList<>();
+        for (TabModel model : selector.getModels()) {
+            List<Tab> tabs = new ArrayList<>();
+            for (int i = 0; i < model.getCount(); i++) {
+                Tab tab = model.getTabAt(i);
+                if (tab != null) tabs.add(tab);
+            }
+            before.add(tabs);
+        }
+        openNewTab.run();
+        int index = 0;
+        for (TabModel model : selector.getModels()) {
+            List<Tab> tabs = before.get(index++);
+            if (tabs.isEmpty()) continue;
+            model.getTabRemover()
+                    .closeTabs(
+                            TabClosureParams.closeTabs(tabs)
+                                    .allowUndo(false)
+                                    .hideTabGroups(false)
+                                    .build(),
+                            /* allowDialog= */ false);
+        }
+    }
