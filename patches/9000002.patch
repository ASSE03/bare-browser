+    /**
+     * Whether the browser process last ended because its task was removed from recents.
+     *
+     * <p>A process that Android ended to free memory is not a swipe and clears nothing. AOSP
+     * records a removed task as requested by the user with the description "remove task"; some
+     * manufacturers use descriptions of their own, which the word checks below try to catch.
+     * Before Android 11 there is no record to read, so an armed process that died is treated as
+     * swiped: clearing too often is the safer mistake here.
+     */
+    private static boolean lastExitWasSwipe(Context context) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return true;
+        ActivityManager manager = context.getSystemService(ActivityManager.class);
+        if (manager == null) return true;
+        String browserProcess = context.getPackageName();
+        for (ApplicationExitInfo info : manager.getHistoricalProcessExitReasons(null, 0, 16)) {
+            if (!browserProcess.equals(info.getProcessName())) continue;
+            // The newest entry for the browser process comes first.
+            if (info.getReason() == ApplicationExitInfo.REASON_USER_REQUESTED) return true;
+            String description = info.getDescription();
+            if (description == null) return false;
+            String lower = description.toLowerCase(java.util.Locale.ROOT);
+            return lower.contains("remove task")
+                    || lower.contains("removetask")
+                    || lower.contains("swipe");
+        }
+        return true;
+    }
